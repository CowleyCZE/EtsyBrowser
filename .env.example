# EtsyBrowser - priklad .env souboru. Nakopiruj na .env a vypln.
# .env je v .gitignore, nikdy ho necommituj!

# Prihlaseni na Etsy (pouziva src/uploader.py)
ETSY_EMAIL=your_email@example.com
ETSY_PASSWORD=your_password

# Automatizace (super_robot.py)
GROQ_API_KEY=
POLLINATIONS_API_KEY=

# Etsy Open API v3 (etsy_api.py)
ETSY_API_KEY=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=
# Volitelne: pevne ID kategorie (jinak se zjisti z taxonomie: Art & Collectibles > Prints > Digital Prints)
ETSY_TAXONOMY_ID=
