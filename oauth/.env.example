# Etsy Developers -> Your Apps
# ETSY_API_KEY = keystring (nikoliv keystring:shared_secret)
ETSY_API_KEY=VLOZ_SVUJ_ETSY_KEYSTRING
ETSY_SHARED_SECRET=VLOZ_SVUJ_ETSY_SHARED_SECRET

# Musí přesně odpovídat callback URL registrované u Etsy.
# Tato výchozí hodnota odpovídá původnímu skriptu a Etsy Quick Start příkladu.
ETSY_REDIRECT_URI=http://localhost:3003/oauth/redirect

# Ponecháno podle původního skriptu. Odeber listings_w, pokud nepotřebuješ zapisovat nabídky.
ETSY_SCOPES=shops_r listings_r listings_w
